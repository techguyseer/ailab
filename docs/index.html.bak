<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rumi Sustainable Line | Transparency Report</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="main-header">
        <div class="container">
            <div class="logo">RUMI</div>
            <nav>
                <a href="#teardown" class="nav-link">Transparency Report</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container">
                <div class="batch-id">BATCH NO: RS-2026-001</div>
                <div class="hero-content">
                    <img src="https://picsum.photos/seed/hero/1200/800" alt="Rumi Sustainable Product" class="hero-image">
                    <h1>RUMI SUSTAINABLE LINE</h1>
                </div>
            </div>
        </section>

        <section id="teardown" class="teardown">
            <div class="container">
                <h2 class="section-title">The Teardown</h2>
                <div class="teardown-grid">
                    <div class="teardown-visual">
                        <div class="image-container">
                            <img src="https://picsum.photos/seed/product/800/600" alt="Product Teardown" class="product-image">
                            <!-- Hotspots -->
                            <div class="hotspot" data-part="upper" style="top: 30%; left: 40%;"></div>
                            <div class="hotspot" data-part="laces" style="top: 45%; left: 48%;"></div>
                            <div class="hotspot" data-part="sole" style="top: 75%; left: 50%;"></div>
                        </div>
                    </div>
                    <div class="teardown-info">
                        <div id="info-panel" class="info-panel">
                            <p class="placeholder-text">Select a component to view sourcing details.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="purchase-portal">
            <div class="container">
                <div class="purchase-card">
                    <img src="https://picsum.photos/seed/detail/400/300" alt="Product Detail" class="portal-thumbnail">
                    <h3>Acquisition</h3>
                    <div class="selector-group">
                        <label for="size">SELECT SIZE</label>
                        <select id="size">
                            <option>EU 40</option>
                            <option>EU 41</option>
                            <option>EU 42</option>
                            <option>EU 43</option>
                        </select>
                    </div>
                    <p class="disclaimer">"Buy only what you need."</p>
                    <button class="buy-button">PURCHASE NOW</button>
                    <a href="#" class="report-link">Read Full Transparency Report &rarr;</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="footer-bottom">
                <div class="legal">
                    <a href="#">Terms</a>
                    <a href="#">Privacy</a>
                    <a href="#">Ethics Code</a>
                </div>
                <div class="copyright">&copy; 2026 RUMI SUSTAINABLE LINE. ALL RIGHTS RESERVED.</div>
            </div>
        </div>
    </footer>

    <script src="main.js"></script>
</body>
</html>
